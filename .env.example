APP_NAME=Handwriting OCR
APP_VERSION=0.4.0-dev
RECOGNIZER_BACKEND=trocr
TROCR_MODEL_NAME=kazars24/trocr-base-handwritten-ru
LOCAL_FINETUNED_MODEL_DIR=models/trocr-cyrillic-finetuned
PREFER_LOCAL_FINETUNED_MODEL=true
MAX_UPLOAD_SIZE_MB=10
MAX_IMAGE_PIXELS=60000000
# MODELS_DIR=C:/Users/username/AppData/Local/HandwritingOCR/models
# MODEL_REGISTRY_PATH=C:/Users/username/AppData/Local/HandwritingOCR/data/runtime/model_registry.json
# MODEL_DOWNLOAD_STATE_PATH=C:/Users/username/AppData/Local/HandwritingOCR/data/runtime/model_downloads.json
# HF_HOME=C:/Users/username/AppData/Local/HandwritingOCR/cache/huggingface
MAX_DOCUMENT_PAGES=100
PDF_RENDER_DPI=160
GENERATION_MAX_NEW_TOKENS=128
QWEN_MODEL_PRESET=light
# QWEN_MODEL_NAME=Qwen/Qwen3-VL-2B-Instruct
# QWEN_LORA_ADAPTER_DIR=models/qwen-vl-ocr-lora
QWEN_DEVICE_MAP=auto
QWEN_TORCH_DTYPE=auto
